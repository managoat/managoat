{
  "name": "@managoat/sdk",
  "version": "13.0.0",
  "description": "Run a coding agent on a real computer, with your repos and your credentials, in one call.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/managoat/managoat.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://github.com/managoat/managoat/tree/main/sdk/typescript",
  "keywords": [
    "managoat",
    "agent",
    "sandbox",
    "coding-agent",
    "acp",
    "sdk"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/node.js",
      "browser": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "openapi-typescript ${MANAGOAT_OPENAPI:-../../dist/openapi.json} -o src/generated/openapi.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts",
    "prepublishOnly": "node scripts/ci-publishes.mjs && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.0"
  },
  "browser": {
    "./dist/node.js": "./dist/index.js"
  }
}
